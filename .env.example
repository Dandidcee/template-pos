# Salin file ini menjadi .env dan isi nilai-nilai di bawah ini

# Supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON=YOUR_SUPABASE_ANON_KEY


# Backend API URL
# VITE_BACKEND_URL=

# Midtrans Payment Gateway
# Client Key untuk frontend (copy dari Midtrans Dashboard → Access Keys)
VITE_MIDTRANS_CLIENT_KEY=Mid-client-YOUR_CLIENT_KEY

# Production mode
# false = Sandbox (testing)
# true = Production (live)
MIDTRANS_IS_PRODUCTION=false
